{
    "name":  "diyaprosoft-lms",
    "version":  "1.0.0",
    "private":  true,
    "workspaces":  [
                       "client",
                       "server"
                   ],
    "scripts":  {
                    "dev":  "concurrently -k -n API,WEB -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
                    "build":  "npm run build -w client",
                    "start":  "npm run start -w server",
                    "seed":  "npm run seed -w server",
                    "test":  "npm run test -w server",
                    "test:integration":  "npm run test:integration -w server"
                },
    "devDependencies":  {
                            "concurrently":  "^9.2.1"
                        },
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "config":  {
                   "mongodbMemoryServer":  {
                                               "disablePostinstall":  true
                                           }
               },
    "overrides":  {
                      "uuid":  "^11.1.1"
                  }
}