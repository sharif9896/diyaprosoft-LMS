PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/diyapro_lms
# Generate a fresh secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Local/full-stack hosting serves client/dist. Set false for the Render API service.
SERVE_CLIENT=true
# Vercel's /api proxy uses lax. Direct cross-site HTTPS requests require none.
COOKIE_SAME_SITE=lax
# 0 locally; 1 behind Render's proxy. Render defaults to 1 when unset.
TRUST_PROXY=0
# Admin seed password must contain at least 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=student@example.com
# Used only when seeding a NEW, empty demo database. Student register number: STU-001.
SEED_STUDENT_DOB=2005-01-15
