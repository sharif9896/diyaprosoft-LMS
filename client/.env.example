# Default for local Vite, single-server hosting, and the included Vercel proxy.
VITE_API_BASE_URL=/api
# For direct cross-site requests instead of the proxy (HTTPS only):
# VITE_API_BASE_URL=https://diyaprosoft-lms-4.onrender.com/api
# This is a public, build-time setting. Never put secrets in VITE_ variables.
# The Vercel build command forces /api to prevent stale hosting URL overrides.
